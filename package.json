{
  "name":"fairytale-science-lab",
  "version":"3.1.0",
  "private":true,
  "description":"Offline Three.js shadow experiment and a scrollable experiment shell",
  "scripts":{"build:3d":"npm run build:shadow && npm run build:cosmos","build:shadow":"esbuild web/src/shadow.js --bundle --format=iife --target=chrome110 --minify --legal-comments=eof --outfile=web/vendor/shadow.bundle.js","build:cosmos":"esbuild web/src/cosmos.js --bundle --format=iife --target=chrome110 --minify --legal-comments=eof --outfile=web/vendor/cosmos.bundle.js","test":"node --test tests/*.test.cjs"},
  "dependencies":{"three":"0.187.0"},
  "devDependencies":{"esbuild":"0.28.2"}
}
